OS-UEFI-INTERACTIVE-ACCESS-V1
role = interactive-native-nonvisual-uefi-menu-v1
system-foundation = true
depends-on = OS-NATIVE-ACCESS-BOOT-V1
canonical-builder = boot/uefi-interactive-access-v1/build_uefi_interactive_access.py
materialized-artifact = EFI/BOOT/BOOTX64.EFI
artifact-format = PE32+ EFI application
input-source = UEFI SystemTable ConIn EFI_SIMPLE_TEXT_INPUT_PROTOCOL ReadKeyStroke
system-table-conin-offset = 0x30
simple-text-input-read-keystroke-offset = 0x08
output-source = direct system-owned COM1 machine I/O
visual-surface = none
screen-reader-dependency = none
windows-uia-dependency = none
nvda-dependency = none
jaws-dependency = none
vision-required = false
pointer-required = false
keyboard-operable = true
human-facing = true
interaction-model = interactive-menu-v1
menu-item-1 = CONTINUE
menu-item-2 = ACCESSIBILITY
menu-item-3 = RECOVERY
continue-action = return EFI_SUCCESS to firmware boot flow
accessibility-action = emit native nonvisual help then return to menu
recovery-action = emit BLOCKED with RECOVERY_NOT_ESTABLISHED then return to menu
invalid-key-action = emit BLOCKED with KEY_NOT_MAPPED then return to menu
semantic-output = same state machine that handles input emits nonvisual state
separate-accessibility-reconstruction = forbidden
native-output-transport = direct machine-code COM1 byte emission
compiler-used-by-tested-path = false
assembler-used-by-tested-path = false
linker-used-by-tested-path = false
guest-os-used = false
guest-runtime-used = false
guest-library-used = false
external-firmware = UEFI OVMF EDK2
external-machine-carrier = x86-64
external-infrastructure-semantics = carrier-and-witness-only
speech-synthesis = not-established
braille-device-output = not-established
audio-driver = not-established
physical-machine-firmware-boot = not-established
secure-boot = not-established
proof = PASS
proof-run = 35375098129
proof-head-sha = 5dd9aa4c88dc30c3f1ea99be4ea08a11c0e89533
proof-linux-job-id = 105697812263
proof-linux = PASS
proof-keyboard-help-continue = PASS
proof-invalid-key-feedback = PASS
proof-recovery-status = PASS
proof-menu-return = PASS
proof-serial-semantic-witness = PASS
