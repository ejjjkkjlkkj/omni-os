OS-UEFI-HDA-WIDGET-V1
role = native pre-OS HDA output widget and route enumeration proof v1
system-foundation = true
depends-on = OS-UEFI-HDA-VERB-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
codec-command-transport = HDA Immediate Command PIO
widget-capabilities-parameter = 0x09
pin-capabilities-parameter = 0x0C
connection-list-length-parameter = 0x0E
get-connect-list-verb = 0xF02
qemu-witness-machine = q35
qemu-witness-codec = hda-duplex
qemu-output-dac-nid = 2
qemu-output-pin-nid = 3
required-dac-widget-type = 0x0
required-pin-widget-type = 0x4
required-pin-output-capability = bit 4
required-pin-connection-count = at least 1
required-pin-first-connection = DAC NID 2
external-audio-driver-required = false
AudioDxe-required = false
operating-system-required = false
serial-role = deterministic evidence only
visual-surface-required = false
pointer-required = false
codec-routing-discovery = direct codec verb responses
CORB-RIRB = not-established
stream-descriptor-output = not-established
audio-playback = not-established
native-hda-speech = not-established
physical-ASUS-HDA = not-established
claim = success proves that native UEFI code queries HDA widget capabilities and the output pin connection list instead of assuming a codec route
claim = success on the QEMU witness requires an Audio Output converter NID 2 and output-capable Pin Complex NID 3 whose connection list points to NID 2
claim = success does not yet prove stream DMA PCM playback or physical laptop routing
proof = PASS
