OS-UEFI-HII-EFI-VAR-CURRENT-V1
role = native pre-OS read-only current-value extraction for a live EFI_IFR_ONE_OF backed by EFI_IFR_VARSTORE_EFI
system-foundation = true
depends-on = OS-UEFI-HII-VARSTORE-DEF-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-screen-reader-required = false
external-accessibility-api-required = false
question-opcode = 0x05 EFI_IFR_ONE_OF
storage-opcode = 0x26 EFI_IFR_VARSTORE_EFI
storage-kind = EFI Variable Storage
storage-read-service = EFI_RUNTIME_SERVICES.GetVariable
runtime-services-system-table-offset-x64 = 0x58
get-variable-runtime-table-offset-x64 = 0x48
variable-name-source = EFI_IFR_VARSTORE_EFI trailing null-terminated ASCII Name
variable-name-conversion = ASCII to CHAR16 before GetVariable
variable-guid-source = EFI_IFR_VARSTORE_EFI.Guid
question-offset-source = EFI_IFR_QUESTION_HEADER.VarStoreInfo.VarOffset
question-width-source = EFI_IFR_ONE_OF.Flags and EFI_IFR_NUMERIC_SIZE mask 0x03
question-width-map = 0 to 1 byte, 1 to 2 bytes, 2 to 4 bytes, 3 to 8 bytes
read-buffer-limit = 65536 bytes
bounds-check = VarOffset plus question width must not exceed declared VarStore size or returned GetVariable DataSize
current-value-output = first question-width bytes at VarOffset, zero-padded to 8 bytes, serial hexadecimal
buffer-varstore-0x24 = explicitly not read by GetVariable
name-value-varstore-0x25 = explicitly not read by GetVariable
set-variable-call = forbidden
varstore-write = forbidden
firmware-setting-mutation = forbidden
claim = success establishes the live current bytes of a storage-backed ONE_OF question by reading its exact EFI variable with RuntimeServices.GetVariable and selecting the question field by VarOffset
claim = success does not change the EFI variable HII configuration firmware setting or option selection
proof = PENDING_CI
