OS-UEFI-CONOUT-SCREENREADER-V2
role = runtime text-driven UEFI speech bridge v2
system-foundation = true
depends-on = OS-UEFI-CONOUT-SCREENREADER-V1
human-facing = true
execution-domain = pre-OS UEFI
screen-reader-core = native
observed-interface = EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL.OutputString
capture-source = actual CHAR16 pointer received by hooked OutputString
runtime-speech-engine = character-level concatenative speech
runtime-dispatch = captured CHAR16 character to PCM asset table
supported-uppercase = A-Z
supported-lowercase = a-z normalized to A-Z
supported-digits = 0-9
supported-space = true
unsupported-character = spoken unknown-symbol fallback
maximum-characters-per-outputstring = 64
phrase-specific-match-required = false
phrase-specific-target-copy-outside-child = forbidden
test-child-text = Az 42
test-child-text-encoding = UTF-16LE
speech-assets = per-character French PCM utterances plus silence and unknown-symbol fallback
speech-assets-generated-by-ci = espeak plus ffmpeg
speech-output = native pre-OS SB16 DSP plus ISA DMA
audio-format = unsigned 8-bit mono 8000 Hz
audio-buffer = low-memory 64 KiB aligned DMA window
original-outputstring-called = true
original-outputstring-restored = true
COM1-role = evidence-only
serial-is-user-facing-speech = false
visual-surface-required = false
pointer-required = false
external-screen-reader-required = false
windows-required = false
linux-required-at-runtime = false
natural-language-tts = not-established
full-unicode-speech = not-established
physical-HDA-driver = not-established
physical-ASUS-firmware-integration = not-established
HII-form-semantics = not-established
secure-boot-mutation = not-established
braille-output = not-established
accessibility-reconstruction = forbidden
claim = unlike v1 this stage does not compare the captured OutputString against one pre-known phrase before speaking
claim = captured CHAR16 data is interpreted at runtime and each supported character selects its own spoken PCM asset
claim = success proves generic runtime speech for the declared alphanumeric subset only, not natural-language synthesis or complete Unicode
