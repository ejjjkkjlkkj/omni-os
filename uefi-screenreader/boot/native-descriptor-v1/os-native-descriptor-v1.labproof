OS-NATIVE-DESCRIPTOR-V1
role = post-firmware system-owned descriptor and interrupt foundation v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = OS-NATIVE-INTERRUPT-V1 architecture
canonical-image-source = boot/native-descriptor-v1/qevarynox-native-descriptor.hex
artifact-length = 2560
artifact-sha256 = b02729b7a51348e5427424adb9cfb2888cd821b31a0836b69724b04eef6c00c7
artifact-format = PE32+ EFI application
post-exit-firmware-calls = none
owned-stack-range = 0x15000..0x25000
owned-gdt-rva = 0x2160
owned-gdt-size = 24
owned-gdt-layout = null descriptor, 64-bit ring0 code descriptor, ring0 data descriptor
owned-gdtr-rva = 0x2180
owned-gdt-observation-rva = 0x2190
owned-code-selector = 0x08
owned-data-selector = 0x10
gdt-load = LGDT after successful ExitBootServices
code-selector-transition = far return to selector 0x08
data-selector-transition = DS ES SS loaded with selector 0x10
gdt-runtime-self-check = SGDT base and limit must equal system-owned GDT and CS must equal 0x08
gdt-pass-marker = QEVARYNOX-GDT-PASS
owned-idt-rva = 0x13000
owned-idtr-rva = 0x14000
owned-idt-selector = fixed system-owned selector 0x08
vector-3 = system-owned INT3 handler with IRETQ return
vector-6 = system-owned UD2 terminal handler
runtime-order = GDT-PASS then GDT-IDT-ARMED then BP-PASS then GDT-IDT-RESUME then UD-PASS
embedded-native-relation-source = lab21/relation-compose0
embedded-native-relation-file-offset = 0x620
embedded-label-exchange-file-offset = 0x624
negative-test = corrupt LAB21 relation and require POST-FAIL before LGDT
hardware-irq-routing = not-established
tss = not-established
ist = not-established
privilege-transition = not-established
paging-ownership = not-established
smp = not-established
compiler-used-by-tested-path = false
assembler-used-by-tested-path = false
linker-used-by-tested-path = false
guest-os-used = false
guest-runtime-used = false
guest-library-used = false
external-firmware = UEFI OVMF EDK2
external-machine-carrier = x86-64
external-infrastructure-semantics = carrier-and-witness-only
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing fault panic interrupt or descriptor diagnostic must expose equivalent native nonvisual state
physical-machine-firmware-boot = not-established
secure-boot = not-established
proof = PENDING
claim = success establishes a post-firmware system-owned GDT stack and IDT with runtime proof that GDTR and CS reference our own descriptors
claim = success establishes that INT3 return and UD2 handling continue to work after switching to the system-owned code and data selectors
claim = success does not establish TSS IST privilege transitions paging hardware IRQ routing SMP or a complete kernel
