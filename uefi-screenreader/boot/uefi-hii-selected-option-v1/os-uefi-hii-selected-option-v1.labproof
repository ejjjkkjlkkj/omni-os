OS-UEFI-HII-SELECTED-OPTION-V1
role = native pre-OS read-only binding from a live Buffer-Storage ONE_OF current value to its matching direct EFI_IFR_ONE_OF_OPTION child
system-foundation = true
depends-on = OS-UEFI-HII-BUFFER-CURRENT-V1
depends-on = OS-UEFI-HII-ISCSI-FIXTURE-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-screen-reader-required = false
external-accessibility-api-required = false
question-opcode = 0x05 EFI_IFR_ONE_OF
option-opcode = 0x09 EFI_IFR_ONE_OF_OPTION
end-opcode = 0x29 EFI_IFR_END
scope-policy = selected option must be a direct child of the live scoped ONE_OF; nested scopes are tracked and excluded
storage-opcode = 0x24 EFI_IFR_VARSTORE
storage-kind = Buffer Storage
storage-read-service = EFI_HII_CONFIG_ROUTING_PROTOCOL.ExportConfig
nested-uefi-call-abi = Microsoft x64 helper reserves 32-byte shadow space plus 8-byte alignment before nested UEFI protocol and Boot Services calls
external-caller-routing = required by UEFI; direct EFI_HII_CONFIG_ACCESS_PROTOCOL invocation is not used
config-response-selection = UTF-16 GUID= and NAME= fields matched against the live EFI_IFR_VARSTORE GUID and Name
current-value-source = live read-only HII Config Routing ExportConfig plus ConfigToBlock
option-value-source = EFI_IFR_ONE_OF_OPTION typed Value field in the same exported Forms package
numeric-types = EFI_IFR_TYPE_NUM_SIZE_8 16 32 64
match-policy = option Type must match ONE_OF numeric size and typed option value must equal current value
selected-option-output = StringId plus Type plus raw 8-byte typed value
selected-option-label-resolution = not-established-in-this-stage
selected-option-speech = not-established-in-this-stage
route-config-call = forbidden
runtime-variable-read = forbidden
set-variable-call = forbidden
varstore-write = forbidden
firmware-setting-mutation = forbidden
claim = success establishes that the live current value of a Buffer-Storage-backed ONE_OF is bound in the same firmware execution to a real direct EFI_IFR_ONE_OF_OPTION child and exposes that child StringId for subsequent native label resolution
claim = success does not yet establish the selected option text or speech; those are separate gates
previous-proof-invalidated-abi-v2 = nested UEFI calls were QEMU-tolerated but lacked helper-local Microsoft x64 shadow space and 16-byte caller alignment; revalidation required
proof = PASS
proof-run = 35395498282
proof-head-sha = 717424c15a883f757eb1c79039f12cafb670f87b
proof-selected-option-child-match = PASS
proof-selected-option-current-match = PASS
proof-question-text = iSCSI Mode
proof-varstore-id = 26214
proof-varstore-offset = 472
proof-current-width = 1
proof-current-value-unsigned = 0
proof-selected-option-string-id = 21
proof-selected-option-type = 0
proof-selected-option-value-unsigned = 0
proof-fixture-expected-label = Disabled
proof-label-resolution = false
proof-selected-option-speech = false
proof-route-config-call = false
proof-set-variable-call = false
proof-setting-mutation = false
