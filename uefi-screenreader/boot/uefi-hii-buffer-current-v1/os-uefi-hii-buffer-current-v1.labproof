OS-UEFI-HII-BUFFER-CURRENT-V1
role = native pre-OS read-only current-value extraction for a live EFI_IFR_ONE_OF backed by EFI_IFR_VARSTORE Buffer Storage
system-foundation = true
depends-on = OS-UEFI-HII-VARSTORE-DEF-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-screen-reader-required = false
external-accessibility-api-required = false
question-opcode = 0x05 EFI_IFR_ONE_OF
storage-opcode = 0x24 EFI_IFR_VARSTORE
storage-kind = Buffer Storage
storage-read-service = EFI_HII_CONFIG_ROUTING_PROTOCOL.ExportConfig
nested-uefi-call-abi = Microsoft x64 helper reserves 32-byte shadow space plus 8-byte alignment before nested UEFI protocol and Boot Services calls
external-caller-routing = required by UEFI; direct EFI_HII_CONFIG_ACCESS_PROTOCOL invocation is not used
export-scope = entire current HII database
config-response-selection = UTF-16 GUID= and NAME= fields matched against the live EFI_IFR_VARSTORE GUID and Name
varstore-name-bounds = EFI_IFR_VARSTORE Name must terminate within the opcode length before ConfigHdr comparison
config-response-isolation = selected current ConfigResp is temporarily NUL-terminated at the next &GUID= boundary in the allocated ExportConfig copy only
binary-reconstruction = EFI_HII_CONFIG_ROUTING_PROTOCOL.ConfigToBlock
question-offset-source = EFI_IFR_QUESTION_HEADER.VarStoreInfo.VarOffset
question-width-source = EFI_IFR_ONE_OF.Flags and EFI_IFR_NUMERIC_SIZE mask 0x03
question-width-map = 0 to 1 byte, 1 to 2 bytes, 2 to 4 bytes, 3 to 8 bytes
read-buffer-limit = 65536 bytes
bounds-check = VarOffset plus question width must not exceed declared VarStore size or ConfigToBlock returned BlockSize
route-config-call = forbidden
runtime-variable-read = forbidden
set-variable-call = forbidden
varstore-write = forbidden
firmware-setting-mutation = forbidden
claim = success establishes the live current bytes of a Buffer-Storage-backed ONE_OF question by exporting current configuration through HII Config Routing, matching the live VarStore GUID and Name, reconstructing the selected ConfigResp with ConfigToBlock, and selecting the field at VarOffset
claim = success does not directly invoke ConfigAccess RouteConfig GetVariable SetVariable or modify any HII configuration firmware setting or option selection
previous-proof-invalidated = runtime metadata did not match OS-UEFI-HII-VARSTORE-DEF-V1; x64 ABI alignment fix and identity revalidation required
previous-proof-invalidated-abi-v2 = nested UEFI calls were QEMU-tolerated but lacked helper-local Microsoft x64 shadow space and 16-byte caller alignment; revalidation required
proof = PASS
proof-run = 35395491788
proof-head-sha = 47095849a1035b6eb3d0a1e14d46530cdb343971
proof-buffer-current-value = PASS
proof-buffer-current-identity-match = PASS
proof-iscsi-fixture-identity-match = PASS
proof-varstore-name-config-match = PASS
proof-read-service = HII Config Routing ExportConfig plus ConfigToBlock
proof-question-text = iSCSI Mode
proof-question-id = 2
proof-varstore-id = 26214
proof-varstore-offset = 472
