OS-UEFI-HDA-SPELL-BUFFER-V1
role = native pre-OS buffered Latin A-Z spelling over runtime-discovered HDA v1
system-foundation = true
depends-on = OS-UEFI-HDA-TEXT-V1
depends-on = OS-UEFI-HDA-ALPHABET-SPEECH-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-audio-driver-required = false
AudioDxe-required = false
input-source = EFI_SIMPLE_TEXT_INPUT_PROTOCOL ReadKeyStroke
runtime-spell-input = required
supported-runtime-graphemes = A-Z,a-z
uppercase-normalization = ASCII uppercase to lowercase
text-commit-key = Enter
max-runtime-graphemes = 8
runtime-text-buffer = UTF-16
runtime-grapheme-to-speech-map = Latin letter to first-party letter-name unit sequence
runtime-allophone-scheduling = one or more native HDA BDL entries per typed grapheme
runtime-bdl-entry-count = 1..56
final-descriptor-proof = SDnSTS BCIS after IOC descriptor
max-bdl-entries = 64
full-letter-name-pcm-assets = 0
recorded-human-speech-assets = false
external-tts-build-dependency = false
speech-unit-source = OS-UEFI-NATIVE-SPEECH-V1 first-party deterministic allophone units
letter-map-source = OS-UEFI-HDA-ALPHABET-SPEECH-V1
buffer-foundation = OS-UEFI-HDA-TEXT-V1
codec-vendor-hardcode = false
widget-nids-hardcoded = false
audio-function-group = discovered at runtime
audio-output-converter = discovered at runtime
output-pin = discovered at runtime
direct-route = discovered at runtime
pin-config-default = queried at runtime
pin-capabilities = queried at runtime
eapd-policy = enable and verify when Pin Capabilities bit 16 advertises EAPD
dac-output-amp = programmed and read back at runtime
codec-command-transport = HDA Immediate Command PIO
stream-transport = native HDA stream descriptor DMA
stream-control = byte-safe SDCTL reset tag and RUN
pci-scan-scope = segment 0 all 65536 bus-device-function tuples
required-runtime-buffer-amwz = true
required-runtime-buffer-code = true
required-runtime-distinct-waveforms = true
required-runtime-final-BDL-IOC = true
runtime-A-Z-buffer-to-HDA-spelling = required
single-character-alphabet = established by dependency
multi-character-buffer = required
natural-language-grapheme-to-phoneme = not-established
word-pronunciation = not-established
arbitrary-text-TTS = not-established
multi-hop-mixer-selector-routing = not-established
physical-ASUS-HDA-speech = not-established
secure-boot = not-established
claim = success establishes that up to eight runtime Latin letters can be buffered in EFI, normalized, expanded into first-party letter-name unit sequences, converted into a runtime HDA BDL, and emitted through a dynamically discovered native HDA output route
claim = success establishes spelling of buffered Latin text, not natural-language pronunciation or unrestricted text-to-speech
claim = success does not establish multi-hop codec routing physical ASUS output or Secure Boot
