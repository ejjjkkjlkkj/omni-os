OS-UEFI-SEED-V1
role = directly-byte-built-x86-64-uefi-execution-seed-v1
system-foundation = true
artifact = EFI/BOOT/BOOTX64.EFI
artifact-format = PE32+ EFI application
machine = AMD64
subsystem = EFI application
artifact-construction = Python writes PE headers sections relocation directory and x86-64 machine instructions directly
assembler = none
compiler = none
linker = none
framework = none
runtime-library = none
entrypoint = raw x86-64 machine instructions
observable-execution = marker emitted through x86 I/O port 0xE9
execution-marker = QEVARYNOX-UEFI-SEED-V1-PASS
termination = QEMU isa-debug-exit I/O port 0xF4
firmware-witness = QEMU EDK2 x86-64 firmware
target-real-runner = AMD-5800H-REAL
host-cpu = AMD Ryzen 7 5800H
boot-medium = QEMU virtual FAT exposing EFI/BOOT/BOOTX64.EFI
independent-observer = GitHub-hosted Linux PE structure and artifact replay
external-infrastructure = Windows AMD x86-64 QEMU EDK2 Python GitHub Actions Linux filesystem
external-infrastructure-semantics = boot-carrier-and-witness-only
physical-machine-firmware-boot = not-established
secure-boot = not-established
hardware-device-driver-semantics = not-established
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing firmware boot selector setup recovery diagnostics secure-boot or pre-OS configuration surface must be operable nonvisually and without pointer or sight dependence
proof = PENDING
claim = success will establish that firmware loads and executes an EFI x86-64 image whose PE structure and machine instructions are emitted directly by this repository without assembler compiler linker framework or runtime library
claim = success will establish an externally observable machine-code execution marker under EDK2/QEMU on the real AMD runner
claim = success will not establish boot on the physical ASUS firmware Secure Boot device initialization kernel loading paging interrupts drivers or a human-facing preboot interface
