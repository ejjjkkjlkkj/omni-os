OS-UEFI-HDA-WORD-SELECT-V1
role = native pre-OS keyboard-selected word synthesis over native HDA DMA v1
system-foundation = true
depends-on = OS-UEFI-NATIVE-SPEECH-V1
depends-on = OS-UEFI-HDA-SPEECH-RUNTIME-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-audio-driver-required = false
AudioDxe-required = false
input-source = EFI_SIMPLE_TEXT_INPUT_PROTOCOL ReadKeyStroke
runtime-word-options = AIDE,ERREUR
key-1-word = AIDE
key-1-allophones = e,d
key-2-word = ERREUR
key-2-allophones = e,r,eu,r
speech-engine-source = OS-UEFI-NATIVE-SPEECH-V1 first-party deterministic allophone units
speech-unit-generation-runtime = build-time
speech-unit-selection-runtime = EFI keyboard branch plus HDA BDL construction
runtime-word-selection = required
runtime-allophone-scheduling = native HDA Buffer Descriptor List
full-utterance-pcm-assets = 0
recorded-human-speech-assets = false
external-tts-build-dependency = false
speech-source-format = unsigned 8-bit mono 8000 Hz
hda-pcm-format = signed 16-bit little-endian stereo 48000 Hz
stream-transport = native HDA stream descriptor DMA
stream-control = byte-safe SDCTL reset tag and RUN
dma-allocation = UEFI AllocatePages below 4GiB
runtime-aide-bdl-entry-count = 2
runtime-erreur-bdl-entry-count = 4
required-runtime-keyboard-selection = true
required-runtime-aide-waveform = true
required-runtime-erreur-waveform = true
required-runtime-distinct-waveforms = true
visual-surface-required = false
pointer-required = false
arbitrary-text-speech = not-established
general-codec-topology-routing = not-established
physical-ASUS-HDA-speech = not-established
secure-boot = not-established
claim = success establishes that EFI keyboard input selects between two distinct first-party words and that the selected allophone sequence is scheduled at runtime over native HDA DMA
claim = success does not establish arbitrary-text TTS generic physical-codec routing physical ASUS output or Secure Boot
