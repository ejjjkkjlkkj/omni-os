OS-UEFI-HDA-OUTPUT-POLICY-V1
role = vendor-agnostic native pre-OS HDA output-device classification and DAC amplifier control v1
system-foundation = true
depends-on = OS-UEFI-HDA-TOPOLOGY-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-audio-driver-required = false
AudioDxe-required = false
codec-vendor-id = discovered at runtime
widget-nids-hardcoded = false
audio-function-group = discovered at runtime
audio-output-converter = discovered at runtime
output-pin = discovered at runtime
direct-route = discovered at runtime
pin-config-default = queried at runtime with GET_CONFIG_DEFAULT
accepted-output-device-classes = line-out,speaker,headphone-out
output-device-class-hardcode = false
dac-output-amp-capabilities = queried at runtime
dac-output-amp-programming = SET_AMP_GAIN_MUTE
dac-output-amp-readback = GET_AMP_GAIN_MUTE
dac-output-amp-target-gain = 0x40
dac-output-amp-target-mute = false
left-channel-readback = required
right-channel-readback = required
pci-scan-scope = segment 0 all 65536 bus-device-function tuples
bar0-32-bit-mmio = supported
bar0-64-bit-mmio = supported
codec-command-transport = HDA Immediate Command PIO
qemu-witness-machine = q35
qemu-witness-controller = ich9-intel-hda
qemu-witness-codec = hda-micro
qemu-witness-pin-default-device = speaker
qemu-witness-mixer = enabled
required-runtime-pin-config-default = true
required-runtime-dac-amp-capabilities = true
required-runtime-dac-amp-program = true
required-runtime-dac-amp-readback = true
multi-hop-mixer-selector-routing = not-established
multi-candidate-pin-priority-selection = not-established
EAPD-programming = not-established
physical-ASUS-codec-topology = not-established
physical-ASUS-HDA-speech = not-established
secure-boot = not-established
claim = success establishes runtime output-pin device classification and runtime DAC output amplifier programming and readback using dynamically discovered widget NIDs
claim = success does not establish multi-hop selector or mixer routing multi-pin competition EAPD physical ASUS compatibility or Secure Boot
proof = PASS
proof-run = 35382022751
proof-head-sha = 1571e62eab54d1824a898d6fa5dc52806ed8f2c8
proof-pin-config-default = PASS
proof-speaker-class-witness = PASS
proof-dac-output-amp-capabilities = PASS
proof-dac-output-amp-program = PASS
proof-dac-output-amp-readback = PASS
proof-widget-NIDs-hardcoded = false
proof-efi-sha256 = ea9ddfbfe56b9d515beef11a3080e5c35d6dfa0f4ce2b74c743b8021117cff1b
