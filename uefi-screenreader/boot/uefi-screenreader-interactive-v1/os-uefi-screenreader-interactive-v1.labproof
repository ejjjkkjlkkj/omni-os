OS-UEFI-SCREENREADER-INTERACTIVE-V1
role = native interactive spoken UEFI screen reader path v1
system-foundation = true
depends-on = OS-UEFI-SCREENREADER-V1
depends-on = OS-UEFI-INTERACTIVE-ACCESS-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
input-source = UEFI EFI_SIMPLE_TEXT_INPUT_PROTOCOL ReadKeyStroke
navigation = scan-code up down
activation = Unicode Enter
focus-model = native firmware-owned integer state
focus-count = 3
focus-item-0 = CONTINUE
focus-item-1 = ACCESSIBILITY
focus-item-2 = RECOVERY
speech-trigger = same native state machine that owns focus and activation
audio-output = direct Sound Blaster 16 DSP plus ISA DMA
audio-format = unsigned 8-bit mono 8000 Hz
audio-assets = embedded PCM utterances
audio-assets-generated-by-ci = espeak plus ffmpeg
native-text-to-speech-engine = not-established
serial-role = deterministic evidence only
serial-is-user-facing-speech = false
visual-surface-required = false
pointer-required = false
windows-required = false
linux-required-at-runtime = false
nvda-required = false
jaws-required = false
screen-reader-required = false
speech-on-entry = required
speech-on-focus-change = required
speech-on-activation = required
speech-on-invalid-key = required
speech-queue = synchronous-v1
speech-interrupt = not-established
speech-rate-control = not-established
speech-volume-control = not-established
physical-hda = not-established
physical-asus-firmware-boot = not-established
secure-boot-mutation = not-established
braille-output = not-established
claim = this stage is not a serial-only accessibility witness: user-facing announcements are emitted as audio by pre-OS machine code
claim = keyboard focus changes and activation select the spoken utterance from the same native UEFI state machine
claim = success proves interactive pre-OS speech on the QEMU SB16 witness only; it does not prove native TTS HDA physical firmware integration or Secure Boot control
