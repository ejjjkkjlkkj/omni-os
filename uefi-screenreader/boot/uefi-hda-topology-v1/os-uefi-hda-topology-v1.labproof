OS-UEFI-HDA-TOPOLOGY-V1
role = vendor-agnostic native pre-OS HDA widget discovery and direct output-route proof v1
system-foundation = true
depends-on = OS-UEFI-HDA-PROBE-V1
depends-on = OS-UEFI-HDA-VERB-V1
depends-on = OS-UEFI-HDA-WIDGET-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-audio-driver-required = false
AudioDxe-required = false
codec-vendor-id = discovered at runtime
codec-vendor-hardcode = false
audio-function-group = discovered at runtime
widget-range = discovered from AFG subordinate-node-count parameter
audio-output-converter = first runtime-discovered widget type 0
output-pin = first runtime-discovered widget type 4 with Pin Capabilities output bit
connection-list-length = discovered at runtime
short-form-connection-list = supported
long-form-connection-list = supported
route-class = direct pin input to audio-output converter
widget-nids-hardcoded = false
bar0-32-bit-mmio = supported
bar0-64-bit-mmio = supported
pci-scan-scope = segment 0 all 65536 bus-device-function tuples
codec-command-transport = HDA Immediate Command PIO
qemu-witness-machine = q35
qemu-witness-controller = ich9-intel-hda
qemu-witness-codec = hda-duplex
required-runtime-AFG-discovery = true
required-runtime-widget-enumeration = true
required-runtime-direct-route = true
multi-hop-mixer-selector-routing = not-established
pin-default-device-priority = not-established
amplifier-programming = not-established
EAPD-programming = not-established
physical-ASUS-codec-topology = not-established
physical-ASUS-HDA-speech = not-established
secure-boot = not-established
claim = success establishes runtime discovery of an audio function group audio-output converter output-capable pin and a direct pin-to-converter connection without hardcoded widget NIDs or codec vendor ID
claim = success does not establish multi-hop mixer selector paths laptop speaker preference amplifier EAPD programming physical ASUS compatibility or Secure Boot
