prompt-source = live read-only HII package export, IFR Prompt StringId plus native Strings-package decoder
prompt-source-hardcoded = false
prompt-string-protocol-required = false
prompt-package-search = all exported Forms-plus-Strings package lists
prompt-language-search = sibling EFI_HII_PACKAGE_STRINGS packages
spoken-character-filter = Latin a-z case-insensitive
