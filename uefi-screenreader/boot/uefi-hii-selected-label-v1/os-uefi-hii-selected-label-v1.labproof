OS-UEFI-HII-SELECTED-LABEL-V1
role = native pre-OS read-only resolution of the currently selected EFI_IFR_ONE_OF_OPTION StringId to its live firmware HII label
system-foundation = true
depends-on = OS-UEFI-HII-SELECTED-OPTION-V1
depends-on = OS-UEFI-HII-ISCSI-FIXTURE-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-screen-reader-required = false
external-accessibility-api-required = false
current-selection-source = OS-UEFI-HII-SELECTED-OPTION-V1 same-execution direct ONE_OF_OPTION current-value match
selected-string-id-source = matched direct EFI_IFR_ONE_OF_OPTION offset plus 2
label-source = sibling EFI_HII_PACKAGE_STRINGS package in the same exported package-list as the selected Forms package
label-resolution = native direct HII string-block decoder keyed by the selected option StringId
label-source-hardcoded = false
fixture-role = independent CI oracle only; fixture text is not used by the runtime resolver
storage-read-service = EFI_HII_CONFIG_ROUTING_PROTOCOL.ExportConfig plus ConfigToBlock
route-config-call = forbidden
runtime-variable-read = forbidden
set-variable-call = forbidden
varstore-write = forbidden
firmware-setting-mutation = forbidden
selected-option-speech = not-established-in-this-stage
physical-ASUS-selected-label = not-established
claim = success establishes that the live current Buffer-Storage ONE_OF value is matched to a real direct ONE_OF_OPTION and that exact option StringId is resolved to text from the same live firmware HII package-list
claim = success does not yet establish speech of the selected label or physical ASUS firmware compatibility
proof = PASS
