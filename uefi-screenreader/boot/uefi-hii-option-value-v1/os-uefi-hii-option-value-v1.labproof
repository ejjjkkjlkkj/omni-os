OS-UEFI-HII-OPTION-VALUE-V1
role = native pre-OS typed-value extraction for a live EFI_IFR_ONE_OF_OPTION resolved from firmware HII
system-foundation = true
depends-on = OS-UEFI-HII-OPTION-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-screen-reader-required = false
external-accessibility-api-required = false
option-opcode = 0x09 EFI_IFR_ONE_OF_OPTION
option-layout = packed Header 2 bytes plus Option StringId 2 bytes plus Flags 1 byte plus Type 1 byte plus a type-sized Value
minimum-option-length = 7 bytes for UINT8
numeric-option-length-map = type 0 to 7 bytes, type 1 to 8 bytes, type 2 to 10 bytes, type 3 to 14 bytes
option-string-id-source = same live EFI_IFR_ONE_OF_OPTION opcode offset plus 2
option-flags-source = same live EFI_IFR_ONE_OF_OPTION opcode offset plus 4
option-type-source = same live EFI_IFR_ONE_OF_OPTION opcode offset plus 5
option-value-source = same live EFI_IFR_ONE_OF_OPTION opcode offset plus 6
supported-option-types = numeric 0x00 UINT8, 0x01 UINT16, 0x02 UINT32, 0x03 UINT64
option-value-width-source = 1 shifted left by numeric Type
option-value-read = exactly the type width at opcode offset plus 6, zero-padded to 8 bytes
option-value-raw-width = 8-byte zero-padded output
numeric-width-map = type 0 to 1 byte, 1 to 2 bytes, 2 to 4 bytes, 3 to 8 bytes
label-resolution = native direct EFI_HII string-block decoder using the Option StringId captured from that same opcode
option-identity-binding = label Type Flags typed width and zero-padded raw Value are captured from one exact live EFI_IFR_ONE_OF_OPTION before string resolution
question-current-value-resolution = not-established
current-option-selection = not-established
varstore-read = not-established
varstore-write = forbidden
firmware-setting-mutation = forbidden
speech-output = not-established-in-this-stage
physical-ASUS-HII = not-established
claim = success establishes a resolved live ONE_OF option label together with the typed raw value encoded in that exact same EFI_IFR_ONE_OF_OPTION
claim = success does not establish that this option is currently selected or mutate any firmware setting
proof = PASS
proof-run = 35394463094
proof-head-sha = 99a6a9d34030654106e37dd66be951d7dc766575
proof-HII-database-protocol = PASS
proof-HII-export-all-package-lists = PASS
proof-Forms-package = PASS
proof-Strings-package = PASS
proof-IFR-option-token = PASS
proof-language-metadata = PASS
proof-direct-string-decoder = PASS
proof-option-resolution = PASS
proof-option-value-binding = PASS
proof-option-identity-match = PASS
proof-resolved-option = Boot Service Data
proof-option-flags-hex = 10
proof-option-type-hex = 00
proof-option-width = 1
proof-option-value-raw8-hex = 0000000000000000
proof-option-value-unsigned = 0
