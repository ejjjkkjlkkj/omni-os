speech-recovery = Récupération indisponible.
speech-invalid = Touche invalide.
speech-continue = Continuer.
audio-device-v2 = Sound Blaster 16 compatible witness
audio-programming = direct DSP plus ISA DMA
audio-rate = 8000
audio-format = unsigned 8-bit mono
audio-buffer = low-memory 64 KiB aligned DMA window
speech-asset-origin = temporary external build-time synthesized witness assets
