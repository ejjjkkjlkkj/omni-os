OS-POST-FIRMWARE-NATIVE-V1
role = post-exitbootservices native relational execution seed
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = LAB26 exact external UEFI PE32+ load witness
canonical-image-source = boot/post-firmware-v1/qevarynox-post-firmware.hex
materialized-artifact = EFI/BOOT/BOOTX64.EFI
artifact-length = 2048
artifact-sha256 = 45e4424c31a129c71653e1e6ae4197c575d9490030d414c9b56fb9afe8662c37
artifact-format = PE32+ EFI application
sections = .text,.data,.reloc
entry-rva = 0x1000
data-rva = 0x2000
data-virtual-size = 0x11000
memory-map-buffer-rva = 0x3000
memory-map-buffer-size = 65536
relocation-directory-rva = 0x13000
system-table-boot-services-pointer-offset = 0x60
boot-services-get-memory-map-offset = 0x38
boot-services-exit-boot-services-offset = 0xe8
firmware-handoff-order = GetMemoryMap immediately followed by ExitBootServices
post-exit-boot-service-calls = none
post-exit-runtime-service-calls = none
post-exit-device-output = direct COM1 port I/O only
embedded-native-relation-source = lab21/relation-compose0
embedded-native-relation-file-offset = 0x420
embedded-label-exchange-file-offset = 0x424
runtime-relation-validation = after successful ExitBootServices
runtime-validation-original = structural two-label relation shape a-not-equal-b and cells a,b,b,a
runtime-validation-exchanged = same structural relation shape after global carrier-label exchange
runtime-cross-label-exchange = original-a equals exchanged-b and original-b equals exchanged-a
runtime-pass-marker = QEVARYNOX-POST-FIRMWARE-NATIVE-V1
runtime-fail-marker = QEVARYNOX-POST-FIRMWARE-FAIL
terminal-state = cli plus hlt loop after marker flush
compiler-used-by-tested-path = false
assembler-used-by-tested-path = false
linker-used-by-tested-path = false
guest-os-used = false
guest-runtime-used = false
guest-library-used = false
external-firmware = UEFI OVMF EDK2
external-machine-carrier = x86-64
external-infrastructure-semantics = carrier-and-witness-only
truth-semantics = none
boolean-semantics = none
integer-semantics = none
carrier-label-semantics = none
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing post-firmware boot recovery failure diagnostics or native-core state must be perceivable and operable nonvisually at the same native layer
physical-machine-firmware-boot = not-established
secure-boot = not-established
paging = not-established
interrupt-ownership = not-established
hardware-driver-model = not-established
proof = PENDING
claim = success establishes that the UEFI loader obtains the current memory map calls ExitBootServices successfully and only then validates the LAB21 native relation before emitting the PASS marker by direct device I/O
claim = after successful ExitBootServices the tested PASS path makes no Boot Service Runtime Service protocol or firmware callback
claim = success establishes post-firmware execution under OVMF but does not yet establish a complete kernel physical ASUS boot Secure Boot paging interrupts multitasking drivers filesystems networking graphics audio or a human-facing interface
