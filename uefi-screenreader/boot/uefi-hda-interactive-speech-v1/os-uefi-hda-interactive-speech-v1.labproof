OS-UEFI-HDA-INTERACTIVE-SPEECH-V1
role = native pre-OS keyboard-selected multi-word speech over runtime-discovered HDA output route v1
system-foundation = true
depends-on = OS-UEFI-HDA-WORD-SELECT-V1
