OS-NATIVE-INTERRUPT-V1
role = post-firmware system-owned interrupt-dispatch foundation v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = OS-POST-FIRMWARE-NATIVE-V1 execution architecture
canonical-image-source = boot/native-interrupt-v1/qevarynox-native-interrupt.hex
materialized-artifact = EFI/BOOT/BOOTX64.EFI
artifact-length = 2560
artifact-sha256 = af29c428e17d62b0c68b31c51d49e6c83db909690011ecc8cdf2f56f0c95f4d5
artifact-format = PE32+ EFI application
entry-rva = 0x1000
data-rva = 0x2000
data-virtual-size = 0x24000
memory-map-buffer-rva = 0x3000
memory-map-buffer-size = 65536
idt-rva = 0x13000
idtr-rva = 0x14000
owned-stack-range = 0x15000..0x25000
owned-stack-size = 65536
relocation-rva = 0x26000
system-table-boot-services-pointer-offset = 0x60
boot-services-get-memory-map-offset = 0x38
boot-services-exit-boot-services-offset = 0xe8
firmware-handoff-order = GetMemoryMap immediately followed by ExitBootServices
post-exit-firmware-calls = none
post-exit-stack = image-owned zero-filled stack
post-exit-interrupt-state = CLI before IDT activation
native-idt = image-owned 4096-byte table
native-idt-limit = 4095
native-idt-vector-3 = present 64-bit interrupt gate to system-owned breakpoint handler
native-idt-vector-6 = present 64-bit interrupt gate to system-owned invalid-opcode handler
native-idt-selector = runtime current CS copied structurally into each gate
native-breakpoint-trigger = INT3
native-breakpoint-handler = emits QEVARYNOX-IDT-BP-PASS then IRETQ
native-breakpoint-return = required
native-invalid-opcode-trigger = UD2 after breakpoint return
native-invalid-opcode-handler = emits QEVARYNOX-IDT-UD-PASS then terminal HLT loop
native-sequence-marker-1 = QEVARYNOX-IDT-ARMED
native-sequence-marker-2 = QEVARYNOX-IDT-BP-PASS
native-sequence-marker-3 = QEVARYNOX-IDT-RESUME
native-sequence-marker-4 = QEVARYNOX-IDT-UD-PASS
embedded-native-relation-source = lab21/relation-compose0
embedded-native-relation-file-offset = 0x620
embedded-label-exchange-file-offset = 0x624
runtime-lab21-validation = after successful ExitBootServices and before IDT activation
negative-test = corrupt LAB21 relation cell 2 after image materialization and require post-exit FAIL before IDT activation
negative-fail-marker = QEVARYNOX-IDT-POST-FAIL
hardware-irq-routing = not-established
apic-programming = not-established
pic-programming = not-established
own-gdt = not-established
privilege-rings = not-established
paging-ownership = not-established
compiler-used-by-tested-path = false
assembler-used-by-tested-path = false
linker-used-by-tested-path = false
guest-os-used = false
guest-runtime-used = false
guest-library-used = false
external-firmware = UEFI OVMF EDK2
external-machine-carrier = x86-64
external-infrastructure-semantics = carrier-and-witness-only
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing interrupt fault panic recovery or diagnostic surface must expose equivalent native nonvisual state and complete nonvisual operation
physical-machine-firmware-boot = not-established
secure-boot = not-established
proof = PENDING
claim = success establishes that after ExitBootServices execution moves to a system-owned stack installs a system-owned IDT and handles two deliberate CPU exceptions without firmware callbacks
claim = success establishes INT3 handler entry and IRETQ return because execution must subsequently emit RESUME and reach the UD2 handler
claim = success establishes terminal system-owned invalid-opcode handling for UD2
claim = success does not establish hardware IRQ routing APIC PIC own GDT privilege rings paging SMP device drivers or a complete kernel
