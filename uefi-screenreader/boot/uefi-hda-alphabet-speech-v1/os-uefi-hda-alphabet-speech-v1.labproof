OS-UEFI-HDA-ALPHABET-SPEECH-V1
role = native pre-OS Latin alphabet speech over runtime-discovered HDA output route v1
system-foundation = true
depends-on = OS-UEFI-HDA-INTERACTIVE-SPEECH-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-audio-driver-required = false
AudioDxe-required = false
input-source = EFI_SIMPLE_TEXT_INPUT_PROTOCOL ReadKeyStroke
runtime-character-options = A-Z,a-z
runtime-character-selection = required
letter-name-sequences = build-time table of first-party speech units
runtime-allophone-scheduling = native HDA Buffer Descriptor List
full-letter-name-pcm-assets = 0
recorded-human-speech-assets = false
codec-vendor-hardcode = false
widget-nids-hardcoded = false
audio-function-group = discovered at runtime
audio-output-converter = discovered at runtime
output-pin = discovered at runtime
direct-route = discovered at runtime
pin-config-default = queried at runtime
dac-output-amp = programmed and read back at runtime
codec-command-transport = HDA Immediate Command PIO
stream-transport = native HDA stream descriptor DMA
stream-control = byte-safe SDCTL reset tag and RUN
pci-scan-scope = segment 0 all 65536 bus-device-function tuples
required-runtime-character-input = true
required-runtime-HDA-output = true
alphabet-coverage = 26 Latin letters
uppercase-and-lowercase-input = required
single-character-spelling = required
multi-character-buffer = not-established
arbitrary-text-speech = not-established
multi-hop-mixer-selector-routing = not-established
physical-ASUS-HDA-speech = not-established
secure-boot = not-established
claim = success establishes a native EFI keyboard path that maps any Latin letter A-Z or a-z to first-party speech units and schedules the selected letter name over runtime-discovered native HDA
claim = success does not establish buffered text reading linguistic grapheme-to-phoneme conversion multi-hop codec routing physical ASUS output or Secure Boot
