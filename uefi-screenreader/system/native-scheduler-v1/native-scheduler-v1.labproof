NATIVE-SCHEDULER-V1
role = system-owned-native-scheduler-foundation-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = LAB24 native transition core v1
scheduler-unit = one native LAB21 relation action
submission-semantics = every submitted native action must be dispatched exactly once
completion-semantics = completion requires all submitted native actions to be accounted for
dispatch-order-semantics = no system meaning is assigned to external worker or completion order
schedule-order-rule = final semantic state is the native composition of all submitted actions and must be invariant to external dispatch order
priority-semantics = none
deadline-semantics = none
preemption-semantics = not-established
worker-identity-semantics = none
external-index-semantics = witness-only
external-concurrency-mechanism = Windows .NET Parallel Interlocked CompareExchange scheduler
external-concurrency-semantics = carrier-and-witness-only
target-real-runner = AMD-5800H-REAL
required-workers = 16
required-submitted-actions = 131072
independent-observer = GitHub-hosted Linux exact dispatch permutation and semantic replay
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing scheduling queue priority cancellation pause resume deadline resource or recovery control must expose equivalent scheduler semantics nonvisually and remain fully operable without sight or pointer dependence
