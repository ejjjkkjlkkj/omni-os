depends-on = NATIVE-CORRECTION-PLAN-V1
depends-on = NATIVE-ACCESSIBILITY-V1
depends-on = NATIVE-OUTPUT-V1
review-source = one structurally derived non-identity correction proposal from isolated negative witness history
human-authority = required
approve-semantics = select proposed native correction action without execution
reject-semantics = select structurally discovered native identity action without execution
boolean-decision-semantics = none
execution = forbidden
