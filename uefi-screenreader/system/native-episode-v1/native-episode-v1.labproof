NATIVE-EPISODE-V1
role = system-owned-episodic-memory-foundation-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = NATIVE-MEMORY-V1
depends-on = NATIVE-GOAL-V1
depends-on = NATIVE-CONTROL-V1
episode-unit = ordered current goal selected-target result native relation elements
episode-width = four native relation elements
episode-append = durable append to external carrier after structural validation
episode-recall = replay each complete episode by deriving the unique native action from current to selected target and verifying result
control-history = selected target preserves whether the human chose current state or supplied goal state
boolean-decision-semantics = none
external-score = none
numeric-carrier-label-semantics = none
process-boundary = each episode append and final replay execute in separate PowerShell processes
target-real-runner = AMD-5800H-REAL
required-episodes = 4
required-goal-targets = 2
required-current-targets = 2
independent-observer = GitHub-hosted Linux structural replay
external-infrastructure = Windows AMD x86-64 Linux filesystem GitHub Actions PowerShell CSharp Python .NET
external-infrastructure-semantics = persistence-carrier-and-witness-only
