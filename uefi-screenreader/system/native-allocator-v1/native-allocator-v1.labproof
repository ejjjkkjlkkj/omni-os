NATIVE-ALLOCATOR-V1
role = system-owned-native-relational-allocation-foundation-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = NATIVE-LOCATION-V1
depends-on = NATIVE-STORE-V1
depends-on = NATIVE-RESOURCE-V1
allocation-selector = exact width-8 native relational selector key
allocation-domain = fixed width-8 structural role mask alternating identity and non-identity relations
allocation-target-derivation = elementwise native composition of selector and allocation domain
allocation-target-derivation-bijection = required across all 256 relational selectors and locations
allocation-unit = one native relational resource
allocation-success = exactly one available-to-held structural transition at derived target
pool-exhaustion = all 256 derived targets held
exhausted-request-result = observe held structural role with no additional transition
release = held-to-available structural transition at the same derived target
reallocation-rule = the same selector must derive the same target independent of external request order
required-locations = 256
required-workers = 16
required-first-allocation-transitions = 256
required-exhausted-pool-rejections = 256
required-first-release-transitions = 256
required-reverse-order-reallocations = 256
required-final-release-transitions = 256
required-final-available-locations = 256
external-request-order-semantics = none
numeric-allocation-id-semantics = none
pointer-semantics = none
integer-address-semantics = none
virtual-address-semantics = not-established
physical-address-semantics = not-established
allocation-size-semantics = one-native-resource
multi-resource-region-semantics = not-established
target-real-runner = AMD-5800H-REAL
independent-observer = GitHub-hosted Linux structural mapping and state replay
external-infrastructure = AMD x86-64 Windows Linux GitHub Actions PowerShell CSharp Python filesystem .NET
external-infrastructure-semantics = carrier-and-witness-only
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing allocation free exhaustion quota ownership memory inspection or recovery surface must expose allocation target and state semantics nonvisually and remain fully operable without sight or pointer dependence
