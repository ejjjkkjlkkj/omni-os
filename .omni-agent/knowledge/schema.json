{
  "schema": 1,
  "states": [
    "PLANNED",
    "IMPLEMENTED",
    "TESTED",
    "VERIFIED",
    "PROVEN",
    "RELEASED",
    "REGRESSED",
    "BLOCKED",
    "UNKNOWN"
  ],
  "provenance": [
    "source_type",
    "repository",
    "ref",
    "commit",
    "path",
    "blob_sha"
  ],
  "dimensions": [
    "correctness",
    "security",
    "accessibility",
    "compatibility",
    "performance",
    "maintainability",
    "tests",
    "evidence"
  ],
  "rule": "UNKNOWN never becomes PASS automatically",
  "release_gate": {
    "required_file": "release-gate.json",
    "rule": "No release claim without satisfying the declared fail-closed gate."
  }
}
