{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ejjjkkjlkkj/omni-security/data/schema/security-knowledge.schema.json",
  "title": "OMNI Security Knowledge Database",
  "type": "object",
  "required": [
    "schema_version",
    "personal_data_policy",
    "record_count",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "personal_data_policy": {
      "type": "string"
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "entity_type"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "entity_type": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
