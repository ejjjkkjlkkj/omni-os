      "risks": [
        "memory-safety",
        "integer-overflow",
        "undefined-behavior",
        "format-string",
        "lifetime",
        "FFI"
      ],
      "checks": [
        "clang-analyzer",
        "clang-tidy",
        "ASan",
        "UBSan",
        "fuzzing"
      ]
    },
    "C++": {
